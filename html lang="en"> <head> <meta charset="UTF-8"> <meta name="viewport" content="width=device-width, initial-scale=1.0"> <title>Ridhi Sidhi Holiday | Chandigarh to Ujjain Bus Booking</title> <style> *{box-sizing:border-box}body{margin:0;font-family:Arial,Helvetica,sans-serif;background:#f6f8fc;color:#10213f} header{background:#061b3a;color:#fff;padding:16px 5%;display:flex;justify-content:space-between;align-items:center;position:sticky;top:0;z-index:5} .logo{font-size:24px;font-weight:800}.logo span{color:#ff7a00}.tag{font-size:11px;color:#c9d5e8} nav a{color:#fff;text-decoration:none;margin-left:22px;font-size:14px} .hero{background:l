<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ridhi Sidhi Holiday | Chandigarh to Ujjain Bus Booking</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f6f8fc;color:#10213f}
header{background:#061b3a;color:#fff;padding:16px 5%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:5}
.logo{font-size:24px;font-weight:800}.logo span{color:#ff7a00}.tag{font-size:11px;color:#c9d5e8}
nav a{color:#fff;text-decoration:none;margin-left:22px;font-size:14px}
.hero{background:linear-gradient(120deg,#071d40dd,#061b3acc),url('https://images.unsplash.com/photo-1599661046289-e31897846e41?auto=format&fit=crop&w=1800&q=80') center/cover;min-height:470px;color:#fff;padding:70px 6% 110px}
.hero h1{font-size:58px;margin:10px 0}.hero h1 span{color:#ffb000}.hero p{font-size:22px}
.btn{background:#ff7a00;color:white;border:0;border-radius:9px;padding:14px 24px;font-weight:700;cursor:pointer}
.search{background:white;color:#152542;max-width:1050px;margin:-65px auto 30px;padding:22px;border-radius:18px;box-shadow:0 12px 35px #17294a25;position:relative}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.field{border:1px solid #dbe2ee;border-radius:9px;padding:11px}.field label{display:block;font-size:11px;color:#65738b;margin-bottom:6px}.field input,.field select{width:100%;border:0;outline:0;font-size:15px;background:white}
section{max-width:1100px;margin:45px auto;padding:0 20px}h2{text-align:center;font-size:30px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:#fff;border-radius:15px;overflow:hidden;box-shadow:0 5px 20px #182b4812}.card img{width:100%;height:170px;object-fit:cover}.card div{padding:16px}.price{font-size:23px;font-weight:800;color:#e85f00}
.booking{display:none;background:#fff;padding:25px;border-radius:15px;box-shadow:0 8px 25px #0001}.bus{border:1px solid #dbe2ee;border-radius:12px;padding:18px;margin:12px 0}.seats{display:grid;grid-template-columns:repeat(4,45px);gap:9px;margin:15px 0}.seat{height:40px;border:1px solid #b7c3d6;border-radius:7px;background:#fff;cursor:pointer}.seat.selected{background:#ff7a00;color:#fff}.seat.booked{background:#9ba6b7;color:#fff;cursor:not-allowed}.summary{background:#f1f5fb;padding:15px;border-radius:10px;margin-top:15px}
footer{background:#061b3a;color:white;padding:40px 6%;margin-top:50px}.contact{font-size:18px}
@media(max-width:750px){nav{display:none}.hero{min-height:390px;padding:45px 5% 90px}.hero h1{font-size:40px}.grid,.cards{grid-template-columns:1fr}.search{margin:-50px 15px 20px}.seats{grid-template-columns:repeat(4,42px)}}
</style>
</head>
<body>
<header>
  <div><div class="logo">RIDHI <span>SIDHI</span> HOLIDAY</div><div class="tag">Travel More, Worry Less</div></div>
  <nav><a href="#home">Home</a><a href="#booking">Bus Booking</a><a href="#packages">Packages</a><a href="#contact">Contact</a></nav>
</header>

<div class="hero" id="home">
  <div>
    <p>🚌 Comfortable AC Seater Bus</p>
    <h1>Chandigarh → <span>UJJAIN</span></h1>
    <h2 style="text-align:left;color:#ffd000;margin:0">🚩 महाकाल दर्शन यात्रा</h2>
    <p>Easy online booking • Seat selection • E-ticket</p>
    <button class="btn" onclick="document.getElementById('booking').style.display='block';document.getElementById('booking').scrollIntoView()">BOOK YOUR SEAT</button>
  </div>
</div>

<div class="search">
  <div class="grid">
    <div class="field"><label>FROM</label><select><option>Chandigarh</option></select></div>
    <div class="field"><label>TO</label><select><option>Ujjain</option></select></div>
    <div class="field"><label>JOURNEY DATE</label><input type="date" id="date"></div>
    <div class="field"><label>PASSENGERS</label><select><option>1 Passenger</option><option>2 Passengers</option><option>3 Passengers</option><option>4 Passengers</option></select></div>
  </div>
  <button class="btn" style="width:100%;margin-top:12px" onclick="showBooking()">SEARCH BUSES 🔎</button>
</div>

<section id="booking">
<h2>Choose Your Seat</h2>
<div class="bus">
  <strong>Ridhi Sidhi Holiday — AC Seater</strong>
  <p>Chandigarh → Ujjain | Departure: 07:00 PM</p>
  <p>Fare: <b>₹2,999 per seat</b></p>
  <div class="seats" id="seats"></div>
  <div class="summary">Selected: <b id="selected">None</b> &nbsp; | &nbsp; Total: <b id="total">₹0</b></div>
  <button class="btn" style="margin-top:15px" onclick="book()">CONTINUE TO BOOKING</button>
</div>
</section>

<section id="packages">
<h2>Popular Tour Packages</h2>
<div class="cards">
  <div class="card"><img src="https://images.unsplash.com/photo-1609947017136-9daf32a5eb16?auto=format&fit=crop&w=900&q=80"><div><h3>Ujjain – Omkareshwar</h3><p>Hotel + Breakfast + Travel</p><div class="price">₹4,500 / person</div></div></div>
  <div class="card"><img src="https://images.unsplash.com/photo-1509644851169-2acc08aa25b5?auto=format&fit=crop&w=900&q=80"><div><h3>Manali – Kasol</h3><p>Comfortable AC Travel + Sightseeing</p><div class="price">₹5,999 / person</div></div></div>
  <div class="card"><img src="https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=900&q=80"><div><h3>Special Darshan Trips</h3><p>New routes coming soon</p><div class="price">Book Now</div></div></div>
</div>
</section>

<section id="contact">
<h2>Book With Confidence</h2>
<div class="cards">
<div class="card"><div><h3>💺 Comfortable Seater</h3><p>AC bus with charging point.</p></div></div>
<div class="card"><div><h3>🎫 Instant E-Ticket</h3><p>Booking confirmation and PNR flow.</p></div></div>
<div class="card"><div><h3>📞 Support</h3><p class="contact">9255005003<br>7532000050<br>7015551050</p></div></div>
</div>
</section>

<footer>
<div class="logo">RIDHI <span>SIDHI</span> HOLIDAY</div>
<p>Travel More, Worry Less</p>
<p>© 2026 Ridhi Sidhi Holiday. All Rights Reserved.</p>
</footer>

<script>
const booked=[3,7,14,21,28,34];
let selected=[];
function renderSeats(){
 const box=document.getElementById('seats'); box.innerHTML='';
 for(let i=1;i<=40;i++){
   const b=document.createElement('button'); b.className='seat'+(booked.includes(i)?' booked':''); b.textContent=i;
   if(!booked.includes(i)) b.onclick=()=>toggle(i,b);
   box.appendChild(b);
 }
}
function toggle(i,b){
 if(selected.includes(i)){selected=selected.filter(x=>x!==i);b.classList.remove('selected')}
 else if(selected.length<4){selected.push(i);b.classList.add('selected')}
 document.getElementById('selected').textContent=selected.length?selected.join(', '):'None';
 document.getElementById('total').textContent='₹'+(selected.length*2999).toLocaleString('en-IN');
}
function showBooking(){document.getElementById('booking').style.display='block';document.getElementById('booking').scrollIntoView({behavior:'smooth'});renderSeats()}
function book(){
 if(!selected.length){alert('Please select a seat first.');return}
 const name=prompt('Passenger name:'); if(!name)return;
 const phone=prompt('Mobile number:'); if(!phone)return;
 alert('Demo booking created for '+name+'\\nSeats: '+selected.join(', ')+'\\nTotal: ₹'+(selected.length*2999).toLocaleString('en-IN')+'\\n\\nLive payment/PNR can be connected in the production version.');
}
renderSeats();
document.getElementById('date').valueAsDate=new Date();
</script>
</body>
</html>
